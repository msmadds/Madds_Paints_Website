# Copy to .env.local for local development. Never commit real values.
# In production, set these in Vercel → Settings → Environment Variables.

# Public site URL (used in email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (PostgreSQL). Use the pooled string for DATABASE_URL.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# DATABASE_POOL_MAX=5

# Admin sign-in
ADMIN_EMAIL=
# Generate with: npm run hash-password -- "your-long-password"
ADMIN_PASSWORD_HASH=
# Random, 32+ characters: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Image uploads (Vercel Blob, public store). Optional locally.
BLOB_READ_WRITE_TOKEN=

# Protects /api/cron/release-holds
CRON_SECRET=

# Email via Resend (optional)
RESEND_API_KEY=
EMAIL_FROM=

# Payments
PAYMENT_PROVIDER=mpesa_manual

# Reserved for future automatic M-Pesa. Leave empty.
MPESA_API_KEY=
MPESA_PUBLIC_KEY=
MPESA_SERVICE_PROVIDER_CODE=
